# Choose GIGACHAT or OPENROUTER.
LLM_PROVIDER=GIGACHAT

# GigaChat authorization key from developers.sber.ru
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Optional PEM bundle for the Russian Trusted Root CA, if TLS verification fails.
GIGACHAT_CA_BUNDLE=

# Only needed when LLM_PROVIDER=OPENROUTER
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Supabase project URL and publishable/anon key. Never put the service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
